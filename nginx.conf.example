# Lumora — Nginx security headers
# Paste inside the relevant `server { ... }` block (both :80 and :443).

add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-zo8AKMEKihDfFeZo3stA1rPvtc30rbeyLY9re6pDDwg='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; media-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=(), interest-cohort=()" always;
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
add_header X-XSS-Protection "0" always;

# Force HTTPS (put this in the :80 server block instead, as a redirect)
# server {
#   listen 80;
#   server_name yourdomain.com;
#   return 301 https://$host$request_uri;
# }

# No directory listings
autoindex off;

# /.well-known/ must stay public (security.txt, ACME challenges, etc.) —
# this location block must come before the dotfile-deny rule below.
location ^~ /.well-known/ {
  allow all;
}

# Deny dotfiles (.git, .env, etc.) — everything else starting with a dot
location ~ /\.(?!well-known) {
  deny all;
}

# Long-lived caching for hashed/static assets
location /assets/ {
  add_header Cache-Control "public, max-age=31536000, immutable" always;
}

error_page 404 /404.html;
